# VECTA Connect | ATLAS | DYNAMIC MARKET INTELLIGENCE — local development example.
# Copy to .env (never commit .env). docker compose reads these for the dev stack.
# Every variable is described in docs/ENVIRONMENT.md.

LOGIN_USERNAME=ops@wfc.local
# Used once to create the single shared credential, then remove it and change the password in Settings.
LOGIN_BOOTSTRAP_PASSWORD=
# Leave empty to keep AI extraction "Not connected" (documents still arrive in Evidence Review).
ANTHROPIC_API_KEY=
AI_MODEL=
# Publication age (days) after which an open notice without a closing date is shown as unverified (review only).
NOTICE_AGE_REVIEW_DAYS=90
