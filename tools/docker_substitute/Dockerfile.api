# SUBSTITUTE build of backend/Dockerfile for environments without registry access.
# Same layout, user, port, health check and commands as the real image; the base is
# assembled from host binaries by build_bases.py instead of python:3.13-slim + the lock.
FROM atlas-substitute/python-runtime:local
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/ ./
COPY VERSION /app/VERSION
USER atlas
EXPOSE 8000
HEALTHCHECK --interval=5s --timeout=5s --retries=6 CMD ["/usr/local/bin/python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=4).status == 200 else 1)"]
CMD ["/usr/local/bin/uvicorn", "--factory", "app.main:app_factory", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
