# SUBSTITUTE for postgres:16-alpine (host PostgreSQL 16 binaries).
FROM atlas-substitute/postgres16:local
USER postgres
ENV PGDATA=/var/lib/postgresql/data
HEALTHCHECK --interval=3s --timeout=3s --retries=30 CMD ["/usr/lib/postgresql/16/bin/pg_isready", "-h", "127.0.0.1", "-U", "atlas"]
CMD ["/usr/local/bin/pg-entrypoint"]
