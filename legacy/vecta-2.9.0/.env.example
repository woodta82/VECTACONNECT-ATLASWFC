# Copy to .env and fill in before running docker compose up

# --- Core ---
DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
FRONTEND_ORIGIN=http://localhost:3000
ENVIRONMENT=development

# --- AI layer (required) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Automation engine ---
SCAN_ENABLED=true
SCAN_INTERVAL_HOURS=12
SAVED_SEARCH_CHECK_MINUTES=15
DIGEST_HOUR_LOCAL=7

# --- Notifications (optional — digest logs instead of sending without these) ---
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=atlas@vectasports.com
DIGEST_TO_EMAIL=

# --- LinkedIn (optional — see docs/DEPLOYMENT.md; Relationship Intelligence
#     works fully without these via public web research + search deep-links) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Security ---
# Single shared login gate behind the branded login screen — always on
# LOGIN_PASSWORD is BOOTSTRAP-ONLY: hashed
# into the database on the very first startup, then never read again —
# rotate the real password from Settings & Admin → Change password.
# Never commit a real password to this file. See docs/SECURITY.md.
LOGIN_USERNAME=tom@vectasports
LOGIN_PASSWORD=
RATE_LIMIT_PER_MINUTE=120
# Set false in production unless already behind the API key gate or a VPN.
DOCS_ENABLED=true
# Rough estimate for the Commercial ROI panel on Reports — not a real
# Anthropic invoice figure. Calibrate once you have real billing data.
ESTIMATED_COST_PER_SCAN_USD=0.50

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
