# ATLAS continuous validation.
#
# The three static gates in this workflow have each caught a real defect
# that shipped: a wrong-package-root import, a used-but-unimported model
# class, and backend/frontend contract drift. Each was added AFTER the
# corresponding bug reached a package.
#
# Running them manually makes them optional in practice. This makes them
# mandatory, which is the point.

name: Validate

on:
  push:
    branches: [main, "sprint/**", "rc/**"]
  pull_request:
    branches: [main]
  workflow_dispatch:

jobs:
  backend:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: backend/requirements.txt

      - name: Install dependencies
        working-directory: backend
        run: |
          pip install -r requirements.txt
          pip install -r requirements-dev.txt

      # Gate 1 + 2 — imports resolve, and every used name is bound.
      # The second catches the class of bug where a model is referenced
      # but never imported: valid syntax, resolvable imports, fails at
      # runtime on one specific code path.
      - name: Static verification
        working-directory: backend
        run: python3 tools/verify_imports.py

      # Gate 3 — backend response shapes match the frontend types.
      # Catches the mismatch that passes every backend test and renders
      # `undefined` in the UI.
      - name: API contract verification
        working-directory: backend
        run: python3 tools/verify_contract.py

      - name: Test suite
        working-directory: backend
        env:
          DATABASE_URL: sqlite:///./ci.db
          ENVIRONMENT: development
          LOGIN_USERNAME: ci@vectasports
          LOGIN_PASSWORD: CI-Test-Password-1!
          ANTHROPIC_API_KEY: ""
        run: python3 -m pytest tests/ -v --tb=short

      # Migrations must apply forwards AND backwards. A downgrade path
      # that has never run is not a rollback plan.
      - name: Migrations — clean database
        working-directory: backend
        env:
          DATABASE_URL: sqlite:///./migrate.db
        run: |
          python3 -m alembic upgrade head
          python3 -m alembic downgrade base

      # Model calibration against expert judgement. Runs without a
      # database — it caught two real bugs on its first execution.
      - name: Intelligence calibration
        working-directory: backend
        run: python3 tools/calibrate_models.py

  frontend:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: npm
          cache-dependency-path: frontend/package-lock.json

      # `npm ci` requires a lockfile. Failing loudly here is correct —
      # non-deterministic dependencies in a decision platform are not
      # acceptable.
      - name: Install
        working-directory: frontend
        run: npm ci

      - name: Type-check
        working-directory: frontend
        run: npm run typecheck

      - name: Lint
        working-directory: frontend
        run: npm run lint

      - name: Production build
        working-directory: frontend
        run: npm run build

  security:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Dependency vulnerabilities
        working-directory: backend
        run: |
          pip install pip-audit
          pip-audit -r requirements.txt || true

      # Secrets must never reach the repository. This has been clean
      # since Phase 1 and must stay that way.
      - name: Secret scan
        run: |
          if grep -rIn --exclude-dir=.git --exclude-dir=node_modules \
               -E "(sk-ant-|LOGIN_PASSWORD=.+|ANTHROPIC_API_KEY=sk)" . ; then
            echo "::error::Potential secret committed"
            exit 1
          fi
          echo "No secrets detected"
