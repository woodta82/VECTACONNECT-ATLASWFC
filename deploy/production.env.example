# VECTA Connect | ATLAS | DYNAMIC MARKET INTELLIGENCE — production configuration EXAMPLE.
# Placeholders only. Put real values in your secret store, never in the repository.
# Configured customer: World Freight Company. See docs/DEPLOYMENT.md and docs/ENVIRONMENT.md.

ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://atlas:<password-from-secret-store>@<db-host>:5432/atlas_wfc
LOGIN_USERNAME=<shared-username>
# First boot only; remove after the first sign-in and password change.
LOGIN_BOOTSTRAP_PASSWORD=<one-time-strong-password>
PUBLIC_ORIGIN=https://<your-atlas-hostname>
TRUSTED_PROXY_HOPS=1
REPORTING_TIMEZONE=Asia/Dubai
CUSTOMER_NAME=World Freight Company
BUILD_ID=<git-sha-or-image-tag>
API_DOCS_ENABLED=false
SNAPSHOT_DIR=/var/lib/atlas/snapshots

# AI extraction (optional). Without all four, extraction stays "Not connected".
ANTHROPIC_API_KEY=<from-secret-store>
AI_MODEL=<model-id-from-provider-docs>
AI_PRICE_INPUT_PER_MTOK=<usd-per-million-input-tokens>
AI_PRICE_OUTPUT_PER_MTOK=<usd-per-million-output-tokens>
AI_API_BASE_URL=https://api.anthropic.com

# Must stay empty in every deployment (local verification only).
RETRIEVAL_ALLOW_PRIVATE_HOSTS=

# Web image build argument (not a runtime variable): BACKEND_INTERNAL_URL=http://api:8000

# Only when the web front end is hosted on Netlify (docs/DEPLOYMENT.md §8): the same 32+ character value is set on the
# Netlify site; the API then answers only requests signed by the site's proxy rule. Leave empty otherwise.
PROXY_SIGNATURE_SECRET=
